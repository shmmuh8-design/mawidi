{
  "name": "mawidi-ios",
  "version": "1.0.0",
  "private": true,
  "description": "موعدي — تطبيق آيفون (Capacitor)",
  "scripts": {
    "build": "rm -rf www && mkdir -p www && cp ../index.html ../app.js ../i18n.js ../data.js ../config.js ../manifest.json ../privacy.html ../support.html www/ && cp -r ../fonts ../icons www/",
    "assets": "capacitor-assets generate --ios --iconBackgroundColor '#5b3df5' --splashBackgroundColor '#5b3df5' --splashBackgroundColorDark '#0f0c22'"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/app": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/assets": "^3.0.5"
  }
}
